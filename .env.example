# The SHAPE of the configuration is committed; the VALUES never are.
# Copy to .env and fill in. .env is git-ignored; this file is not. NEVER commit .env.
# A placeholder that is a real key is exactly how these get committed - leave every value empty.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SUPABASE_DB_URL=
MONGODB_URI=
