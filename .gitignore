# --- secrets: never, under any circumstances ---
.env
.env.*
!.env.example
*.pem
*.key

# --- environments and caches: a tool made them, a tool can remake them ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- data: tracked by provenance, not by Git ---
data/raw/*
data/processed/*
!data/raw/SOURCE.md
!.gitkeep

# --- generated artifacts ---
mlruns/
.chroma/
*.db
dist/
build/
read.md
# generated by scripts/check_pins.py
.pins-cache.json
